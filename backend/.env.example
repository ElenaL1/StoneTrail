DATABASE_URL=postgresql+asyncpg://stonetrail:stonetrail@localhost:5432/stonetrail
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
AUTH_DEBUG_LINKS=true
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Yandex ID. Leave empty until the OAuth app exists.
# Redirect URI must match the value registered at oauth.yandex.ru.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=http://localhost:8000/auth/yandex/callback

# SMTP Selectel — locally leave empty and keep AUTH_DEBUG_LINKS=true.
# SMTP_HOST=smtp.mail.selcloud.ru
# SMTP_PORT=1126
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@stonetrail.ru
# SMTP_FROM_NAME=StoneTrail

