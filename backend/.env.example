DATABASE_URL=postgresql+asyncpg://stonetrail:stonetrail@localhost:5432/stonetrail
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
AUTH_DEBUG_LINKS=true
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Yandex ID. Leave empty until the OAuth app exists.
# Redirect URI must match the value registered at oauth.yandex.ru.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=http://localhost:8000/auth/yandex/callback

# SMTP Selectel — locally leave empty and keep AUTH_DEBUG_LINKS=true.
# SMTP_HOST=smtp.mail.selcloud.ru
# SMTP_PORT=1126
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@stonetrail.ru
# SMTP_FROM_NAME=StoneTrail
# INQUIRY_TO=sales@stonetrail.ru, office@stonetrail.ru

# Selectel Object Storage. Leave empty until the bucket exists.
# Region must be the pool code (ru-1), not us-east-1.
# S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
# S3_REGION=ru-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=
# S3_UPLOAD_EXPIRES_SECONDS=300
# MAX_IMAGE_SIZE_BYTES=10485760
# MAX_AVATAR_SIZE_BYTES=1048576
# MAX_VIDEO_SIZE_BYTES=104857600
# MEDIA_PENDING_TTL_SECONDS=86400

